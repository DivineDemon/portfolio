generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model clients {
  id          Int        @id @default(autoincrement())
  image       String?
  company     String
  content     String
  designation String
  clientName  String
  feedback    String?
  projects    projects[]
}

model projects {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  title            String
  headlineResult   String
  industry         String?
  role             String
  engagementModel  String?
  teamSize         Int?
  durationInMonths Int?
  problem          String
  situation        String?
  approach         String
  architecture     String
  execution        String
  whatMadeThisHard String?
  whatWeBuilt      String
  results          String
  metrics          Json?
  techStack        String[]
  infrastructure   String[]
  integrations     String[]
  coverImage       String
  galleryImages    String[]
  demoUrl          String?
  repositoryUrl    String?
  seoTitle         String?
  seoDescription   String?
  keywords         String[]
  featured         Boolean  @default(false)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  businessOutcome  String?
  beforeAfter      String?
  engagementType   String?
  cardOutcome      String?
  displayOrder     Int?
  isLive           Boolean  @default(false)
  galleryCaptions  String[] @default([])
  clientId         Int?
  client           clients? @relation(fields: [clientId], references: [id])
}
