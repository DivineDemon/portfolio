generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model projects {
  image        String?
  features     String        @default(dbgenerated("ARRAY[]::text[]"))
  link         String
  id           Int           @id @default(autoincrement())
  start_year   Int
  project_name String
  company_id   Int
  case_studies case_studies?
  companies    companies     @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projects_company_id_companies_id_fk")
}

model testimonials {
  image       String?
  id          Int     @id @default(autoincrement())
  company     String
  content     String
  designation String
  client_name String
}

model documents {
  id         BigInt                 @id @default(autoincrement())
  text       String
  metadata   Json?                  @default("{}")
  embedding  Unsupported("vector(3072)")?
  created_at DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at DateTime?              @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_documents_created_at")
  @@index([metadata], map: "idx_documents_metadata", type: Gin)
}

model case_studies {
  id                  Int      @id @default(autoincrement())
  project_id          Int      @unique(map: "case_studies_project_id_unique")
  title               String
  description         String
  challenge           String
  results             String
  onboarding_improved String
  retention_increase  String
  time_spent_increase String
  research            String
  architecture        String
  wireframing         String
  testing             String
  design              String
  tech_stack_urls     String
  ceo_statement       String
  conclusion          String
  images              String?
  projects            projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "case_studies_project_id_projects_id_fk")
}

model companies {
  id        Int        @id @default(autoincrement())
  hq        String
  founded   Int
  industry  String
  revenue   String
  size      String
  ceo_name  String
  ceo_title String
  name      String
  projects  projects[]
}
