---
import "@/assets/css/index.css";
import PostHog from "@/components/analytics/post-hog.astro";
import Footer from "@/components/landing/footer";
import Navbar from "@/components/landing/navbar";
import Providers from "@/components/providers";
import SEO from "@/components/seo/seo.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  canonicalUrl?: string;
  type?: "website" | "article" | "profile";
  schemaData?: Record<string, unknown> | Record<string, unknown>[];
  className?: string;
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo-dark.svg" />
    
    <!-- SEO Meta Tags & Schema.org JSON-LD -->
    <SEO {...Astro.props} />
    
    <!-- Analytics -->
    <PostHog />

    <!-- Theme Initialization Script -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("vite-ui-theme");
        if (storedTheme === "light") {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Providers client:load>
      <div class="flex min-h-screen flex-col">
        <Navbar client:load />
        <main class={`flex-1 ${Astro.props.className || ""}`}>
          <slot />
        </main>
        <Footer client:load />
      </div>
    </Providers>
  </body>
</html>
