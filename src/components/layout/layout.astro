---
import { LayoutProviders } from "./layout-providers";
import "@/styles/global.css";
import { DATA } from "@/data/resume";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
}

const {
	title = `${DATA.name} | ${DATA.title}`,
	description = DATA.description,
	image = `${DATA.url}/og-image.png`,
	canonicalUrl = DATA.url,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const posthogToken = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN;
const posthogHost =
	import.meta.env.PUBLIC_POSTHOG_HOST || "https://app.posthog.com";

const schemaData = {
	"@context": "https://schema.org",
	"@type": ["Person", "ProfessionalService"],
	name: DATA.name,
	url: DATA.url,
	image: `${DATA.url}/logo.svg`,
	jobTitle: "Senior AI Systems Architect & Consultant",
	worksFor: {
		"@type": "Organization",
		name: "Haga AI & Autonomous Systems Consultancy",
	},
	sameAs: [
		"https://linkedin.com/in/mushood-hanif",
		"https://github.com/DivineDemon",
		"https://haga.mushoodhanif.com",
	],
	description: DATA.summary,
	knowsAbout: [
		"Enterprise AI Automation",
		"Agentic Workflow Engineering",
		"LangGraph Orchestration",
		"Model Context Protocol (MCP)",
		"QLoRA & PEFT LLM Fine-Tuning",
		"vLLM High-Throughput Inference",
		"FAISS Vector Search & RAG",
		"Real-Time Fraud Scoring & Streaming Infrastructure",
		"Enterprise AI Enablement & Governance",
	],
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "AI Automation & Enablement Services",
		itemListElement: DATA.services.map((service, index) => ({
			"@type": "Offer",
			itemOffered: {
				"@type": "Service",
				name: service.title,
				description: service.description,
			},
			position: index + 1,
		})),
	},
};
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="icon" type="image/svg+xml" href="/logo-invert.svg" media="(prefers-color-scheme: dark)" />
		<link rel="shortcut icon" href="/logo.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Enterprise AI Automation, Agentic Workflow Development, AI Enablement Consultant, Custom LLM Fine-Tuning, LangGraph Developer, MCP Integration, vLLM Serving, RAG Architecture, Mushood Hanif"
		/>
		<meta name="author" content={DATA.name} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:site_name" content={`${DATA.name} — AI Systems Architect`} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />

		<!-- Structured Data (JSON-LD) -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

		<!-- Google Analytics -->
		{gaId && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script is:inline define:vars={{ gaId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaId);
				</script>
			</>
		)}

		<!-- PostHog Analytics -->
		{posthogToken && (
			<script is:inline define:vars={{ posthogToken, posthogHost }}>
				!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify_group".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1.0)}(document,window.posthog||[]);
				posthog.init(posthogToken, {api_host: posthogHost});
			</script>
		)}
	</head>
	<body class="relative min-h-screen bg-background text-foreground antialiased font-sans selection:bg-primary/20 selection:text-primary">
		<LayoutProviders client:load>
			<main class="relative z-10 max-w-3xl mx-auto py-12 pb-24 sm:py-20 px-6">
				<slot />
			</main>
		</LayoutProviders>
	</body>
</html>