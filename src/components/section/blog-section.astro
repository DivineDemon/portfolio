---
import { getCollection } from "astro:content";
import { ArrowRight, Calendar, Notebook } from "lucide-react";
import BlurFade from "@/components/magicui/blur-fade";

const BLUR_FADE_DELAY = 0.04;

const posts = await getCollection("posts");
const sortedPosts = posts
	.sort((a, b) => {
		const dateA = new Date(a.data.publishedAt || a.data.date || 0).getTime();
		const dateB = new Date(b.data.publishedAt || b.data.date || 0).getTime();
		return dateB - dateA;
	})
	.slice(0, 4);
---

<section id="blog" class="scroll-mt-20">
	<div class="flex min-h-0 flex-col gap-y-8">
		<div class="flex flex-col gap-y-4 items-center justify-center">
			<div class="flex items-center w-full">
				<div class="flex-1 h-px bg-linear-to-r from-transparent via-border to-transparent" />
				<div class="border bg-primary/10 border-primary/20 text-primary z-10 rounded-full px-4 py-1">
					<span class="text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5">
						<Notebook className="size-3.5" />
						Technical Writing & Insights
					</span>
				</div>
				<div class="flex-1 h-px bg-linear-to-l from-transparent via-border to-transparent" />
			</div>
			<div class="flex flex-col gap-y-2 items-center justify-center text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					AI Systems & Engineering Articles
				</h2>
				<p class="text-muted-foreground max-w-xl md:text-base text-balance">
					Deep-dives into agentic architectures, physical AI verification, LLM fine-tuning, and production AI performance.
				</p>
			</div>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[800px] mx-auto w-full">
			{sortedPosts.map((post, idx) => (
				<BlurFade client:load delay={BLUR_FADE_DELAY * 10 + idx * 0.05}>
					<a
						href={`/blog/${post.id}`}
						class="flex flex-col h-full p-6 rounded-2xl border border-border/80 bg-card hover:bg-card/80 hover:border-primary/50 hover:shadow-lg transition-all duration-300 group"
					>
						<div class="flex items-center gap-2 text-xs text-muted-foreground font-mono mb-2">
							<Calendar className="size-3.5 text-primary" />
							<span>{post.data.publishedAt || post.data.date || "Recent"}</span>
						</div>
						
						<h3 class="font-bold text-lg leading-snug tracking-tight text-foreground group-hover:text-primary transition-colors mb-2">
							{post.data.title}
						</h3>

						<p class="text-xs text-muted-foreground line-clamp-3 leading-relaxed mb-4">
							{post.data.summary || post.data.description || "Read full technical article."}
						</p>

						<div class="mt-auto pt-3 border-t border-border/40 flex items-center justify-between text-xs font-semibold text-primary">
							<span>Read Article</span>
							<ArrowRight className="size-3.5 group-hover:translate-x-1 transition-transform" />
						</div>
					</a>
				</BlurFade>
			))}
		</div>

		<div class="flex justify-center pt-2">
			<a
				href="/blog"
				class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-border bg-card hover:bg-muted font-semibold text-sm transition-all"
			>
				<span>View All {posts.length} Articles</span>
				<ArrowRight className="size-4" />
			</a>
		</div>
	</div>
</section>
