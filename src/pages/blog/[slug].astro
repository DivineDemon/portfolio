---
import { ArrowLeft, Calendar, Clock, FolderX } from "lucide-react";
import MaxWidthWrapper from "@/components/max-width-wrapper";
import { buttonVariants } from "@/components/ui/button";
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty";
import MarkdownRenderer from "@/components/ui/markdown-renderer";
import Quote from "@/components/ui/quote";
import BaseLayout from "@/layouts/base-layout.astro";
import { fetchBlogPostBySlugFromD1 } from "@/lib/d1-content";

const { slug } = Astro.params;
const runtime = Astro.locals.runtime;
const db = runtime?.env?.DB;

const post = slug ? await fetchBlogPostBySlugFromD1(slug, db) : undefined;

const pageTitle = post ? `${post.title} — Mushood Hanif` : "Article Not Found — Mushood Hanif";
const pageDescription = post ? post.description : "Article could not be located.";

const schemaData = post
  ? [
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: post.title,
        description: post.description,
        author: {
          "@type": "Person",
          name: post.author || "Mushood Hanif",
          url: `${Astro.site}`,
        },
        datePublished: post.date,
        url: `${Astro.site}blog/${post.slug}`,
        keywords: post.tags ? post.tags.join(", ") : undefined,
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${Astro.site}`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: `${Astro.site}blog`,
          },
          {
            "@type": "ListItem",
            position: 3,
            name: post.title,
            item: `${Astro.site}blog/${post.slug}`,
          },
        ],
      },
    ]
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  article={true}
  publishedTime={post?.date}
  tags={post?.tags}
  schemaData={schemaData}
>
  {!post ? (
    <MaxWidthWrapper className="flex min-h-[calc(100dvh-64px)] flex-col items-center justify-center gap-6 pt-32">
      <Empty>
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <FolderX className="size-8 text-muted-foreground" />
          </EmptyMedia>
          <EmptyTitle>Article Not Found.</EmptyTitle>
          <EmptyDescription>
            The requested publication &ldquo;{slug}&rdquo; could not be located.
          </EmptyDescription>
        </EmptyHeader>
        <EmptyContent className="flex-row justify-center gap-2">
          <a
            class={buttonVariants({
              variant: "default",
              size: "lg",
            })}
            href="/blog"
          >
            <ArrowLeft className="mr-2 size-4" />
            Back to All Articles
          </a>
        </EmptyContent>
      </Empty>
    </MaxWidthWrapper>
  ) : (
    <MaxWidthWrapper className="flex min-h-screen w-full flex-col items-start justify-start gap-10 pt-28 pb-20">
      <div class="flex w-full flex-col items-start justify-center gap-5">
        <a
          class="flex items-center justify-start gap-2 font-semibold text-primary text-xs hover:underline"
          href="/blog"
        >
          <ArrowLeft className="size-4" />
          <span>Back to All Articles</span>
        </a>
        <h1 class="font-bold font-heading text-3xl leading-tight sm:text-4xl md:text-5xl">
          {post.title}
        </h1>

        <Quote text={post.description} />

        <div class="flex w-full flex-wrap items-center justify-between gap-5 border-border/50 border-t pt-5 text-muted-foreground text-xs">
          <div class="flex items-center gap-2">
            <Calendar className="size-4 text-primary" />
            <span>{post.date}</span>
          </div>
          <div class="flex items-center gap-2">
            <Clock className="size-4 text-primary" />
            <span>{post.readingTime}</span>
          </div>
        </div>
      </div>

      <div class="w-full max-w-full space-y-6 overflow-x-auto text-foreground/90 text-sm leading-relaxed sm:text-base [&>blockquote]:border-primary/60 [&>blockquote]:border-l-4 [&>blockquote]:pl-4 [&>blockquote]:text-muted-foreground [&>blockquote]:italic [&>code]:rounded-md [&>code]:bg-muted [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:font-mono [&>code]:text-xs [&>h2]:border-border/40 [&>h2]:border-b [&>h2]:pt-6 [&>h2]:pb-2 [&>h2]:font-bold [&>h2]:font-heading [&>h2]:text-2xl [&>h3]:pt-4 [&>h3]:font-heading [&>h3]:font-semibold [&>h3]:text-xl [&>ol]:list-decimal [&>ol]:space-y-2 [&>ol]:pl-6 [&>pre]:overflow-x-auto [&>pre]:rounded-xl [&>pre]:bg-muted/80 [&>pre]:p-4 [&>ul]:list-disc [&>ul]:space-y-2 [&>ul]:pl-6 [&_img]:my-4 [&_img]:rounded-xl [&_img]:border [&_table]:my-4 [&_table]:w-full [&_table]:border-collapse [&_td]:border [&_td]:border-border/40 [&_td]:p-3 [&_th]:border [&_th]:border-border/60 [&_th]:bg-muted/60 [&_th]:p-3 [&_th]:text-left [&_th]:font-semibold">
        <MarkdownRenderer client:load content={post.content} />
      </div>
    </MaxWidthWrapper>
  )}
</BaseLayout>
