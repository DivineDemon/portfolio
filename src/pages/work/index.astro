---
export const prerender = false;

import { ArrowUpRight } from "lucide-react";
import MaxWidthWrapper from "@/components/max-width-wrapper";
import { Badge } from "@/components/ui/badge";
import Quote from "@/components/ui/quote";
import SectionBadge from "@/components/ui/section-badge";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";
import BaseLayout from "@/layouts/base-layout.astro";
import { fetchCaseStudiesFromD1 } from "@/lib/d1-content";
import { env } from "cloudflare:workers";

const db = env.DB;
const caseStudies = await fetchCaseStudiesFromD1(db);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Engineering Archive & Case Studies — Mushood Hanif",
  description:
    "Production AI microservices, multi-agent LLM systems, fine-tuning frameworks, and physical AI evaluation suites built by Mushood Hanif.",
  url: `${Astro.site}work`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: caseStudies.map((cs, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      url: `${Astro.site}work/${cs.slug}`,
      name: cs.title,
    })),
  },
};
---

<BaseLayout
  title="Engineering Archive & Case Studies — Mushood Hanif"
  description="Explore production AI microservices, multi-agent LLM systems, fine-tuning frameworks, and physical AI evaluation suites built by Mushood Hanif."
  schemaData={schemaData}
>
  <MaxWidthWrapper className="flex min-h-screen w-full flex-col items-center justify-start gap-10 pt-28 pb-20">
    <div class="flex w-full flex-col items-start justify-center gap-5">
      <SectionBadge label="portfolio & systems" />
      <h1 class="mb-2.5 font-bold font-heading text-4xl sm:text-6xl md:text-7xl">
        Engineering Archive.
      </h1>
      <Quote text="A comprehensive catalog of production AI microservices, multi-agent LLM systems, fine-tuning frameworks, and physical AI evaluation suites built across my career." />
    </div>

    <div class="relative flex w-full flex-col gap-8">
      {caseStudies.map((cs) => (
        <a
          class="group flex w-full flex-col items-center justify-center gap-5 rounded-2xl border border-border/80 bg-card/60 p-5 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-primary/60 hover:shadow-xl sm:p-7"
          href={`/work/${cs.slug}`}
        >
          <div class="flex w-full items-center justify-center gap-2.5">
            <Badge variant="outline">{cs.type}</Badge>
            <Badge>{cs.clientCompany}</Badge>
            <ArrowUpRight className="ml-auto size-4.5 text-primary transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </div>

          <h2 class="w-full text-left font-bold font-heading text-2xl text-foreground transition-colors group-hover:text-primary sm:text-3xl">
            {cs.title}
          </h2>

          <div class="line-clamp-3 w-full text-left text-muted-foreground text-xs leading-relaxed sm:text-sm [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_code]:py-0.5 [&_p]:inline [&_strong]:font-semibold [&_strong]:text-foreground">
            <ReactMarkdown remarkPlugins={[remarkGfm]}>{cs.description}</ReactMarkdown>
          </div>

          {cs.tags && cs.tags.length > 0 && (
            <div class="flex w-full flex-wrap items-start justify-start gap-2">
              {cs.tags.map((tag) => (
                <span
                  class="rounded-md border border-border/70 bg-muted/40 px-2.5 py-1 font-medium text-[11px] text-muted-foreground"
                >
                  {tag}
                </span>
              ))}
            </div>
          )}

          {cs.metrics && cs.metrics.length > 0 && (
            <div class="grid w-full grid-cols-1 gap-4 border-border/50 border-t pt-5 sm:grid-cols-3">
              {cs.metrics.map((m) => (
                <div class="flex flex-col gap-1">
                  <span class="font-bold font-heading text-2xl text-primary">{m.value}</span>
                  <span class="font-semibold text-foreground text-xs">{m.label}</span>
                  {m.subtext && (
                    <span class="text-[11px] text-muted-foreground">{m.subtext}</span>
                  )}
                </div>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </MaxWidthWrapper>
</BaseLayout>
