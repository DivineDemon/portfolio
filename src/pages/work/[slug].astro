---
import { ArrowLeft, Calendar, FolderX, User } from "lucide-react";
import MaxWidthWrapper from "@/components/max-width-wrapper";
import { buttonVariants } from "@/components/ui/button";
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty";
import MarkdownRenderer from "@/components/ui/markdown-renderer";
import Quote from "@/components/ui/quote";
import BaseLayout from "@/layouts/base-layout.astro";
import { getCaseStudyBySlug, getAllCaseStudies } from "@/lib/mdx";

export async function getStaticPaths() {
  const caseStudies = getAllCaseStudies();
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
  }));
}

const { slug } = Astro.params;
const caseStudy = slug ? getCaseStudyBySlug(slug) : undefined;

const pageTitle = caseStudy
  ? `${caseStudy.title} — Technical Case Study | Mushood Hanif`
  : "Case Study Not Found — Mushood Hanif";
const pageDescription = caseStudy ? caseStudy.description : "Case study could not be located.";

const schemaData = caseStudy
  ? [
      {
        "@context": "https://schema.org",
        "@type": "TechArticle",
        headline: caseStudy.title,
        description: caseStudy.description,
        author: {
          "@type": "Person",
          name: caseStudy.author || "Mushood Hanif",
          url: `${Astro.site}`,
        },
        datePublished: caseStudy.date,
        url: `${Astro.site}work/${caseStudy.slug}`,
        keywords: caseStudy.tags ? caseStudy.tags.join(", ") : undefined,
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${Astro.site}`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Work",
            item: `${Astro.site}work`,
          },
          {
            "@type": "ListItem",
            position: 3,
            name: caseStudy.title,
            item: `${Astro.site}work/${caseStudy.slug}`,
          },
        ],
      },
    ]
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  article={true}
  publishedTime={caseStudy?.date}
  tags={caseStudy?.tags}
  schemaData={schemaData}
>
  {!caseStudy ? (
    <MaxWidthWrapper className="flex min-h-[calc(100dvh-64px)] flex-col items-center justify-center gap-6 pt-32">
      <Empty>
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <FolderX className="size-8 text-muted-foreground" />
          </EmptyMedia>
          <EmptyTitle>Case Study Not Found.</EmptyTitle>
          <EmptyDescription>
            The requested case study &ldquo;{slug}&rdquo; could not be located.
          </EmptyDescription>
        </EmptyHeader>
        <EmptyContent className="flex-row justify-center gap-2">
          <a
            class={buttonVariants({
              variant: "default",
              size: "lg",
            })}
            href="/work"
          >
            <ArrowLeft className="mr-2 size-4" />
            Back to All Projects
          </a>
        </EmptyContent>
      </Empty>
    </MaxWidthWrapper>
  ) : (
    <MaxWidthWrapper className="flex min-h-screen w-full flex-col items-start justify-start gap-10 pt-28 pb-20">
      <div class="flex w-full flex-col items-start justify-center gap-6">
        <a
          class="flex items-center justify-start gap-2 font-semibold text-primary text-xs hover:underline"
          href="/work"
        >
          <ArrowLeft className="size-4" />
          <span>Back to All Projects</span>
        </a>

        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-primary/30 bg-primary/10 px-3.5 py-1 font-medium text-primary text-xs uppercase tracking-wider">
            {caseStudy.type}
          </span>
          <span class="rounded-full border border-border bg-muted/60 px-3.5 py-1 font-mono text-muted-foreground text-xs">
            {caseStudy.clientCompany}
          </span>
          {caseStudy.role && (
            <span class="rounded-full border border-border bg-card/80 px-3.5 py-1 text-muted-foreground text-xs">
              <span class="font-semibold text-foreground">Role:</span> {caseStudy.role}
            </span>
          )}
        </div>

        <h1 class="font-bold font-heading text-3xl leading-tight sm:text-4xl md:text-5xl">
          {caseStudy.title}
        </h1>

        <Quote text={caseStudy.description} />

        {caseStudy.tags && caseStudy.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {caseStudy.tags.map((tag) => (
              <span
                class="rounded-md border border-border/80 bg-muted/50 px-2.5 py-1 font-medium text-muted-foreground text-xs"
              >
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="flex w-full flex-wrap items-center justify-between gap-4 border-border/50 border-t pt-5 text-muted-foreground text-xs">
          <div class="flex items-center gap-2">
            <Calendar className="size-4 text-primary" />
            <span>{caseStudy.date}</span>
          </div>
          <div class="flex items-center gap-2">
            <User className="size-4 text-primary" />
            <span>{caseStudy.author}</span>
          </div>
        </div>
      </div>

      {caseStudy.metrics && caseStudy.metrics.length > 0 && (
        <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
          {caseStudy.metrics.map((m) => (
            <div
              class="flex flex-col gap-1 rounded-2xl border border-border/60 bg-card/60 p-6 shadow-xs"
            >
              <span class="font-bold font-heading text-3xl text-primary">{m.value}</span>
              <span class="font-semibold text-foreground text-sm">{m.label}</span>
              {m.subtext && <span class="text-muted-foreground text-xs">{m.subtext}</span>}
            </div>
          ))}
        </div>
      )}

      <div class="w-full max-w-full space-y-6 overflow-x-auto text-foreground/90 text-sm leading-relaxed sm:text-base [&>blockquote]:border-primary/60 [&>blockquote]:border-l-4 [&>blockquote]:pl-4 [&>blockquote]:text-muted-foreground [&>blockquote]:italic [&>code]:rounded-md [&>code]:bg-muted [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:font-mono [&>code]:text-xs [&>h2]:border-border/40 [&>h2]:border-b [&>h2]:pt-6 [&>h2]:pb-2 [&>h2]:font-bold [&>h2]:font-heading [&>h2]:text-2xl [&>h3]:pt-4 [&>h3]:font-heading [&>h3]:font-semibold [&>h3]:text-xl [&>ol]:list-decimal [&>ol]:space-y-2 [&>ol]:pl-6 [&>pre]:overflow-x-auto [&>pre]:rounded-xl [&>pre]:bg-muted/80 [&>pre]:p-4 [&>ul]:list-disc [&>ul]:space-y-2 [&>ul]:pl-6 [&_img]:my-4 [&_img]:rounded-xl [&_img]:border [&_table]:my-4 [&_table]:w-full [&_table]:border-collapse [&_td]:border [&_td]:border-border/40 [&_td]:p-3 [&_th]:border [&_th]:border-border/60 [&_th]:bg-muted/60 [&_th]:p-3 [&_th]:text-left [&_th]:font-semibold">
        <MarkdownRenderer client:load content={caseStudy.content} />
      </div>
    </MaxWidthWrapper>
  )}
</BaseLayout>
