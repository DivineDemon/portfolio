---
import { ArrowRight, ArrowUpRight, ShieldCheck, Sparkles } from "lucide-react";
import Markdown from "react-markdown";
import Layout from "@/components/layout/layout.astro";
import BlurFade from "@/components/magicui/blur-fade";
import BlurFadeText from "@/components/magicui/blur-fade-text";
import BlogSection from "@/components/section/blog-section.astro";
import ContactSection from "@/components/section/contact-section";
import MetricsSection from "@/components/section/metrics-section";
import ProjectsSection from "@/components/section/projects-section";
import ServicesSection from "@/components/section/services-section";
import SkillsSection from "@/components/section/skills-section";
import WorkSection from "@/components/section/work-section";
import { CompositeAvatar } from "@/components/ui/avatar";
import { DATA } from "@/data/resume";

const BLUR_FADE_DELAY = 0.04;
---

<Layout title={`${DATA.name} | ${DATA.title}`} description={DATA.description}>
	<div class="min-h-screen flex flex-col gap-16 relative">
		
		<!-- Hero Section (Contains the ONLY <h1> on the page) -->
		<section id="hero" class="relative pt-4">
			<div class="mx-auto w-full space-y-6">
				<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
					<div class="flex flex-col gap-3 order-2 md:order-1 flex-1">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold w-fit">
							<Sparkles className="size-3.5" />
							<span>Enterprise AI Automation & Enablement</span>
						</div>

						<!-- Sole <h1> on Homepage for Strict SEO Hierarchy -->
						<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl leading-tight">
							{DATA.headline}
						</h1>

						<BlurFadeText
							client:load
							className="text-muted-foreground max-w-[620px] text-base sm:text-lg leading-relaxed"
							delay={BLUR_FADE_DELAY * 2}
							text={DATA.description}
						/>

						<div class="flex flex-wrap items-center gap-3 pt-2">
							<a
								href="#contact"
								class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-all shadow-md"
							>
								<span>Schedule AI Systems Audit</span>
								<ArrowRight className="size-4" />
							</a>
							<a
								href="#case-studies"
								class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border bg-card hover:bg-muted font-medium text-sm transition-all"
							>
								<span>Explore Case Studies</span>
							</a>
						</div>
					</div>

					<BlurFade client:load delay={BLUR_FADE_DELAY} className="order-1 md:order-2 shrink-0">
						<CompositeAvatar
							client:load
							className="size-28 md:size-36 border-2 rounded-2xl shadow-xl ring-4 ring-muted object-cover"
							src={DATA.avatarUrl}
							fallback={DATA.initials}
							alt={DATA.name}
						/>
					</BlurFade>
				</div>
			</div>
		</section>

		<!-- Metrics Bar Section -->
		<MetricsSection client:load />

		<!-- Core Service Pillars -->
		<ServicesSection client:load />

		<!-- Enterprise Case Studies (Interactive Modal on Click) -->
		<ProjectsSection client:load />

		<!-- Homepage Blog Section -->
		<BlogSection />

		<!-- About & Security Philosophy Section -->
		<section id="about" class="scroll-mt-20">
			<div class="flex min-h-0 flex-col gap-y-4 p-8 rounded-2xl border border-border/80 bg-card/40">
				<BlurFade client:load delay={BLUR_FADE_DELAY * 3}>
					<div class="flex items-center gap-2">
						<ShieldCheck className="size-5 text-primary" />
						<h2 class="text-2xl font-bold tracking-tight">Engineering Approach & Security First</h2>
					</div>
				</BlurFade>
				<BlurFade client:load delay={BLUR_FADE_DELAY * 4}>
					<div class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground text-sm sm:text-base dark:prose-invert">
						<Markdown client:load children={DATA.summary} />
					</div>
				</BlurFade>
			</div>
		</section>

		<!-- Client Track Record & Experience -->
		<section id="work" class="scroll-mt-20">
			<div class="flex min-h-0 flex-col gap-y-6">
				<BlurFade client:load delay={BLUR_FADE_DELAY * 5}>
					<div class="flex flex-col gap-1">
						<h2 class="text-2xl font-bold tracking-tight">Enterprise Client Engagements & Track Record</h2>
						<p class="text-sm text-muted-foreground">Engineering leadership and production delivery history across enterprise systems.</p>
					</div>
				</BlurFade>
				<BlurFade client:load delay={BLUR_FADE_DELAY * 6}>
					<WorkSection client:load />
				</BlurFade>
			</div>
		</section>

		<!-- Technical Skills Section -->
		<section id="skills" class="scroll-mt-20">
			<div class="flex min-h-0 flex-col gap-y-4">
				<BlurFade client:load delay={BLUR_FADE_DELAY * 9}>
					<h2 class="text-2xl font-bold tracking-tight">Tech Stack & Infrastructure</h2>
				</BlurFade>
				<SkillsSection client:load />
			</div>
		</section>

		<!-- Education -->
		<section id="education" class="scroll-mt-20">
			<div class="flex min-h-0 flex-col gap-y-6">
				<BlurFade client:load delay={BLUR_FADE_DELAY * 7}>
					<h2 class="text-2xl font-bold tracking-tight">Education</h2>
				</BlurFade>
				<div class="flex flex-col gap-4">
					{DATA.education.map((education, index) => (
						<BlurFade
							client:load
							delay={BLUR_FADE_DELAY * 8 + index * 0.05}
						>
							<a
								href={education.href}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center gap-x-3 justify-between p-4 rounded-xl border border-border/80 bg-card hover:bg-muted/50 transition-all group"
							>
								<div class="flex items-center gap-x-3 flex-1 min-w-0">
									{education.logoUrl ? (
										<img
											src={education.logoUrl}
											alt={education.school}
											class="size-8 md:size-10 p-1 border rounded-xl shadow ring-2 ring-border overflow-hidden object-contain flex-none bg-background"
										/>
									) : (
										<div class="size-8 md:size-10 p-1 border rounded-xl shadow ring-2 ring-border bg-muted flex-none" />
									)}
									<div class="flex-1 min-w-0 flex flex-col gap-0.5">
										<div class="font-semibold text-sm sm:text-base leading-none flex items-center gap-2">
											{education.school}
											<ArrowUpRight className="h-3.5 w-3.5 text-muted-foreground opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" aria-hidden />
										</div>
										<div class="font-sans text-xs sm:text-sm text-muted-foreground mt-1">
											{education.degree}
										</div>
									</div>
								</div>
								<div class="flex items-center gap-1 text-xs font-mono text-muted-foreground text-right flex-none">
									<span>
										{education.start} - {education.end}
									</span>
								</div>
							</a>
						</BlurFade>
					))}
				</div>
			</div>
		</section>

		<!-- Contact / Interactive EmailJS Audit Booking Form -->
		<section id="contact-booking" class="scroll-mt-20">
			<BlurFade client:load delay={BLUR_FADE_DELAY * 16}>
				<ContactSection client:load />
			</BlurFade>
		</section>

	</div>
</Layout>
